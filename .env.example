DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
MESSAGE_STORE_URL=https://emailsender-inbound.yoursubdomain.workers.dev
APP_URL=https://your-app.vercel.app
TIMEZONE=Africa/Lagos
INBOUND_SECRET=your-shared-secret-between-worker-and-nextjs

# QStash (Upstash) - For exact-time webhook triggers
QSTASH_TOKEN=ey...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Trigger.dev - For DailyScheduler (2am cron) & CampaignMailSender background task
TRIGGER_SECRET_KEY=tr_dev_...

# Firebase Cloud Messaging (Push Notifications)
# Server credentials (either JSON / base64 string or individual fields):
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Web Client Push configuration (from Firebase Console Web App & Cloud Messaging):
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef...
NEXT_PUBLIC_FIREBASE_VAPID_KEY=B...
